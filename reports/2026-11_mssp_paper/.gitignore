# LaTeX build files and the compiled PDF (rebuild with latexmk -pdf main.tex)
*.aux
*.log
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz
*.bbl
*.blg
/main.pdf
# photo originals stay on the server; only the JPG copies used by the figures are versioned
LDV_photos/*.HEIC
LDV_photos/*.heic
# the repository's root .gitignore excludes *.pdf and *.png; re-include the paper's figures and the archived outline
!figures/*.pdf
!figures/*.png
!figures/source/*.pdf
!figures/source/*.png
!outline/*.pdf
